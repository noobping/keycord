{
    "files.watcherExclude": {
        ".git/objects/**": true,
        ".git/subtree-cache/**": true,
        ".hg/store/**": true,
        "*/.git/objects/**": true,
        "*/.git/subtree-cache/**": true,
        "*/.hg/store/**": true,
        ".flatpak/**": true,
        "_build/**": true
    },
    "rust-analyzer.server.path": "${workspaceFolder}/.flatpak/rust-analyzer.sh",
    "rust-analyzer.runnables.command": "${workspaceFolder}/.flatpak/cargo.sh"
}