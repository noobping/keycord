{
  "id": "io.github.noobping.keycord",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "keycord",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm22"
  ],
  "build-options": {
    "prepend-path": "/app/bin:/usr/lib/sdk/llvm22/bin",
    "prepend-ld-library-path": "/app/lib:/usr/lib/sdk/llvm22/lib",
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "append-ld-library-path": "/usr/lib/sdk/rust-stable/lib",
    "env": {
      "CLANG_PATH": "/usr/lib/sdk/llvm22/bin/clang",
      "CARGO_HOME": "/run/build/keycord/cargo",
      "LIBCLANG_PATH": "/usr/lib/sdk/llvm22/lib",
      "BINDGEN_EXTRA_CLANG_ARGS": "-resource-dir=/usr/lib/sdk/llvm22/lib/clang/22"
    }
  },
  "finish-args": [
    "--device=dri",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "capnproto",
      "buildsystem": "autotools",
      "subdir": "c++",
      "no-autogen": true,
      "config-opts": [
        "--disable-static"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/capnproto/capnproto.git",
          "tag": "v1.5.0",
          "commit": "373e61ec89e2359f1c362e9b2eadc552f4779306"
        },
        {
          "type": "shell",
          "commands": [
            "cd c++ && autoreconf -fi"
          ]
        }
      ]
    },
    {
      "name": "pcsc-lite",
      "buildsystem": "meson",
      "config-opts": [
        "-Dlibsystemd=false",
        "-Dpolkit=false",
        "-Dipcdir=/run/pcscd"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/LudovicRousseau/PCSC.git",
          "tag": "2.5.2",
          "commit": "6cadd8152f3cfdb79131a65843d9b85f01f0ae51"
        }
      ]
    },
    {
      "name": "git",
      "buildsystem": "autotools",
      "no-autogen": true,
      "config-opts": [
        "--without-tcltk"
      ],
      "make-args": [
        "prefix=/app",
        "NO_GETTEXT=YesPlease",
        "NO_INSTALL_HARDLINKS=YesPlease",
        "NO_PERL=YesPlease",
        "NO_PYTHON=YesPlease",
        "SKIP_DASHED_BUILT_INS=YesPlease"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/git/git.git",
          "tag": "v2.56.0",
          "commit": "a018953688f1b10bddf91bff8747068f5f4746a4"
        },
        {
          "type": "shell",
          "commands": [
            "make configure"
          ]
        }
      ]
    },
    {
      "name": "nettle",
      "buildsystem": "autotools",
      "config-opts": [
        "--libdir=/app/lib",
        "--disable-static",
        "--disable-documentation"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ftp.gnu.org/gnu/nettle/nettle-3.10.2.tar.gz",
          "sha256": "fe9ff51cb1f2abb5e65a6b8c10a92da0ab5ab6eaf26e7fc2b675c45f1fb519b5"
        }
      ]
    },
    {
      "name": "keycord",
      "buildsystem": "meson",
      "build-options": {
        "env": {
          "AWS_LC_SYS_CMAKE_BUILDER": "1",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "config-opts": [
        "-Dcargo_variant=developer",
        "-Dcargo_features=flatpak,passkey",
        "--libdir=lib"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".",
          "skip": [
            ".git",
            ".flatpak",
            ".flatpak-builder",
            "build-dir",
            "builddir",
            "target"
          ]
        },
        "cargo-sources.yml"
      ]
    }
  ]
}
